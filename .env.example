# Bitbucket Cloud API (Atlassian account token)
BB_EMAIL=seu.email@empresa.com
BB_TOKEN=cole_seu_token_aqui
BB_WORKSPACE=w1consultoria
BB_REPO=w1nner
# Opcional: mapeia projeto -> repo/prefixo no Bitbucket.
# Exemplo com W1NNER e S1NC no mesmo repositorio:
# FLOW_PMO_BITBUCKET_REPO_MAP={"W1NNER":{"repo":"w1nner","prefix":"w1nner"},"S1NC":{"repo":"w1nner","prefix":"s1nc"},"BEFINANCE":{"repo":"befinance","prefix":"befinance"},"DATA&ANALYTICS":{"repo":"dataanalytics","prefix":"dataanalytics"}}
# Opcional: override explicito dos prefixos Jira usados para filtrar work items por projeto.
# FLOW_PMO_BITBUCKET_ISSUE_KEY_PREFIX_MAP={"S1NC":["S1NC","W1SFT"],"W1NNER":["W1NNR","W1NNER"],"BEFINANCE":["BF"],"DATA&ANALYTICS":["DT","DA"]}

# Pasta central para publicar todos os arquivos *latest*
FLOW_PMO_LATEST_DIR=C:\Users\W1 TI\OneDrive - W1\Documentos\Dados\latest

# Mapeamento opcional de senioridade por pessoa para análises por faixa de story points
# Exemplo: {"Lorraine Caribe":"Senior","Fulano":"Junior"}
FLOW_PMO_PERSON_SENIORITY_MAP=

# Portfólio one page completo: marca itens Highest com estrela (fallback manual opcional)
# IDs separados por ; ou , (ex.: BT-202;BT-155)
FLOW_PMO_PORTFOLIO_HIGHEST_IDS=
# Títulos separados por ; ou , (match normalizado)
FLOW_PMO_PORTFOLIO_HIGHEST_TITLES=
