# =============================================================================
# Autenticação Google OAuth 2.0
# =============================================================================
# Como configurar no Google Cloud Console:
#   1. Acesse console.cloud.google.com → APIs & Services → Credentials
#   2. Clique em "Create Credentials" → "OAuth 2.0 Client ID"
#   3. Application type: Web application
#   4. Authorized redirect URIs:
#        https://flow-pmo.vercel.app/callback
#        http://localhost:3000/callback  (desenvolvimento local)
#   5. Copie o Client ID e o Client Secret abaixo
GOOGLE_CLIENT_ID=cole_o_client_id_aqui
GOOGLE_CLIENT_SECRET=cole_o_client_secret_aqui

# String aleatória longa usada para assinar as sessões Flask.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cole_uma_string_aleatoria_longa_aqui

# Domínio principal do Google Workspace usado como hint no login e para exibir o tenant.
# No projeto W1, mantenha `w1.com.br`. O bloqueio real de acesso é feito por
# `FLOW_PMO_ALLOWED_EMAILS` ou, no futuro, por `FLOW_PMO_ALLOWED_GROUP`.
# Contas Gmail pessoais seguem bloqueadas pela ausência do claim `hd`.
FLOW_PMO_ALLOWED_DOMAIN=w1.com.br

# Controle de acesso atual: allowlist estática por e-mail.
# Separe múltiplos e-mails por vírgula. Pode incluir usuários dos domínios
# `w1.com.br`, `w1consultoria.com.br` e `w1technology.com.br`.
FLOW_PMO_ALLOWED_EMAILS=

# Opcional: grupo do Google Workspace permitido.
# A checagem por grupo só entra em vigor quando as 3 variáveis abaixo estiverem
# configuradas ao mesmo tempo:
#   - FLOW_PMO_ALLOWED_GROUP
#   - GOOGLE_SERVICE_ACCOUNT_JSON
#   - GOOGLE_IMPERSONATE_EMAIL
FLOW_PMO_ALLOWED_GROUP=

# Credenciais para checagem dinâmica de grupo.
# `GOOGLE_SERVICE_ACCOUNT_JSON` aceita:
#   - JSON puro
#   - JSON com `\n` escapado
#   - o mesmo conteúdo em base64
# `GOOGLE_IMPERSONATE_EMAIL` deve ser um usuário/admin do Workspace autorizado
# para Domain-Wide Delegation no Admin SDK Directory API.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_EMAIL=

# =============================================================================
# Bitbucket Cloud API (Atlassian account token)
BB_EMAIL=seu.email@empresa.com
BB_TOKEN=cole_seu_token_aqui
BB_WORKSPACE=w1consultoria
BB_REPO=w1nner
# Opcional: mapeia projeto -> repo/prefixo no Bitbucket.
# Exemplo com W1NNER e S1NC no mesmo repositorio:
# FLOW_PMO_BITBUCKET_REPO_MAP={"W1NNER":{"repo":"w1nner","prefix":"w1nner"},"S1NC":{"repo":"w1nner","prefix":"s1nc"},"BEFINANCE":{"repo":"befinance","prefix":"befinance"},"DATA&ANALYTICS":{"repo":"dataanalytics","prefix":"dataanalytics"}}
# Opcional: override explicito dos prefixos Jira usados para filtrar work items por projeto.
# FLOW_PMO_BITBUCKET_ISSUE_KEY_PREFIX_MAP={"S1NC":["S1NC","W1SFT"],"W1NNER":["W1NNR","W1NNER"],"BEFINANCE":["BF"],"DATA&ANALYTICS":["DT","DA"]}

# Pasta central para publicar todos os arquivos *latest*
FLOW_PMO_LATEST_DIR=C:\Users\W1 TI\OneDrive - W1\Documentos\Dados\latest

# SLA padrão da visão de serviço/Lead Time, em dias.
FLOW_PMO_ONE_PAGE_SLA_DAYS=5

# SLA por projeto em dias. Use chaves em MAIÚSCULAS.
FLOW_PMO_ONE_PAGE_SLA_DAYS_MAP={"W1NNER":5,"S1NC":5,"BEFINANCE":5,"DATA&ANALYTICS":5}

# Modelo heurístico de custos do portfólio.
# `fl_mensal` é dado interno da empresa e por isso fica `0` no exemplo até ser informado.
# Os demais valores abaixo são referências de mercado para Brasil e servem como ponto de partida.
FLOW_PMO_PORTFOLIO_COST_MODEL="{\"fl_mensal\":0,\"budget_ti_pct\":0.10,\"fator_encargos\":2.0,\"custo_ferramentas_infra_mensal\":35000,\"dias_uteis_mes\":22,\"horas_dia\":8,\"fator_produtividade\":0.75,\"salario_medio_bruto\":12000}"

# Salário bruto mensal heurístico por papel.
FLOW_PMO_PORTFOLIO_ROLE_SALARY_MAP="{\"Dev\":10000,\"Tech Lead\":18000}"

# Salário bruto mensal heurístico por BU/time.
# Quando existir, este mapa prevalece sobre o mapa por papel no dashboard.
FLOW_PMO_PORTFOLIO_BU_SALARY_MAP="{\"BeFinance\":14000,\"Dados\":12000,\"Sistemas - S1NC\":11000,\"Sistemas - W1NNER\":11500,\"Arquitetura\":18000,\"Cross\":13000,\"Cyber\":13000,\"Governanca\":16000,\"Infra\":11500}"

# Override opcional de custo hora monetário por produto.
# Mantido alinhado ao custo carregado heurístico das BUs de produto.
FLOW_PMO_PM_COST_PER_HOUR_MAP="{\"BF\":212,\"DT\":182,\"S1NC\":167,\"W1NNER\":174}"

# Mapeamento opcional de senioridade por pessoa para análises por faixa de story points
# Exemplo: {"Lorraine Caribe":"Senior","Fulano":"Junior"}
FLOW_PMO_PERSON_SENIORITY_MAP=

# Portfólio one page completo: marca itens Highest com estrela (fallback manual opcional)
# IDs separados por ; ou , (ex.: BT-202;BT-155)
FLOW_PMO_PORTFOLIO_HIGHEST_IDS=
# Títulos separados por ; ou , (match normalizado)
FLOW_PMO_PORTFOLIO_HIGHEST_TITLES=
