# Flow-PMO — Variáveis de ambiente locais
# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local está no .gitignore — nunca commite credenciais.

# --- Autenticação Google OAuth2 ---
FLASK_SECRET_KEY=your-flask-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# --- Controle de acesso ---
FLOW_PMO_ALLOWED_DOMAIN=your-domain.com.br
FLOW_PMO_ALLOWED_GROUP=sso-group@your-domain.com.br
FLOW_PMO_ALLOWED_EMAILS=user1@your-domain.com,user2@your-domain.com

# --- AWS (para acesso aos modelos S3) ---
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1

# --- Módulo Dash a carregar ---
FLOW_PMO_DASH_MODULE=dashboard_full
FLOW_PMO_DASH_ATTR=app

# --- URLs dos modelos de dados (S3) ---
FLOW_PMO_MODEL_URL=https://your-bucket.s3.region.amazonaws.com/PowerBI_Model_latest.xlsx
FLOW_PMO_PORTFOLIO_CSV_URL=https://your-bucket.s3.region.amazonaws.com/portfolio-bt-ns-latest-data.csv
FLOW_PMO_BOTTLENECK_CSV_URL_MAP=https://your-bucket.s3.region.amazonaws.com/bottlenecks_consolidado_latest.xlsx
FLOW_PMO_FOUR_PS_KANBAN_CSV_URL=https://your-bucket.s3.region.amazonaws.com/four_ps_kanban.csv
FLOW_PMO_DOWNSTREAM_CSV_URL_MAP={"W1NNER":"https://...","S1NC":"https://...","BEFINANCE":"https://...","DATA&ANALYTICS":"https://..."}
FLOW_PMO_PROCESS_MINING_REPORT_URL={"w1nner":"https://...","s1nc":"https://...","befinance":"https://...","dataanalytics":"https://..."}
FLOW_PMO_BITBUCKET_CSV_URL_MAP={"w1nner_commits":"https://...","w1nner_pullrequests":"https://..."}

# --- Cache ---
FLOW_PMO_CACHE_DIR=/tmp/flow-pmo-models
FLOW_PMO_REMOTE_CACHE_TTL_SECONDS=300

# --- Configuração de SLA ---
FLOW_PMO_ONE_PAGE_SLA_DAYS=5
FLOW_PMO_ONE_PAGE_SLA_DAYS_MAP={"W1NNER":5,"S1NC":5,"BEFINANCE":5,"DATA&ANALYTICS":5}

# --- Configuração financeira (sensível) ---
FLOW_PMO_PM_COST_PER_HOUR_MAP={"BF":0,"DT":0,"S1NC":0,"W1NNER":0}
FLOW_PMO_PORTFOLIO_BU_SALARY_MAP={"BeFinance":0,"Dados":0,"Sistemas - S1NC":0,"Sistemas - W1NNER":0}
FLOW_PMO_PORTFOLIO_COST_MODEL={"fl_mensal":0,"budget_ti_pct":0.10,"fator_encargos":2.0,"custo_ferramentas_infra_mensal":0,"dias_uteis_mes":22,"horas_dia":8,"fator_produtividade":0.75,"salario_medio_bruto":0}
FLOW_PMO_PORTFOLIO_ROLE_SALARY_MAP={"Dev":0,"Tech Lead":0}
