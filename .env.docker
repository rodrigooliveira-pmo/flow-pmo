# ── Aplicação ──
FLOW_PMO_DASH_MODULE=dashboard_full
FLOW_PMO_DASH_ATTR=app

# ── URLs de dados S3 ──
FLOW_PMO_MODEL_URL=https://w1-flow-pmo-dashboards.s3.us-east-1.amazonaws.com/PowerBI_Model_latest.xlsx
FLOW_PMO_PORTFOLIO_CSV_URL=https://w1-flow-pmo-dashboards.s3.us-east-1.amazonaws.com/portfolio-bt-ns-latest-data.csv
